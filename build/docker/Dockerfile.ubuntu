################################################################################
#                                     BUILD                                    #
################################################################################

# What to build, and how, is a build argument so CI can rehearse the whole
# pipeline on a tiny target. The defaults are the real build.
ARG DEPS_TARGETS="@com_google_googlesql//googlesql/public:value @com_google_googlesql//googlesql/public:analyzer"
ARG BUILD_TARGETS="//binaries:emulator_main //binaries:gateway_main"
# How long one segment of the compile may run before it is stopped cleanly.
ARG SEGMENT_SECONDS=2400
# Two parallel jobs and a capped JVM keep a 16GB runner from running out of
# memory: GoogleSQL translation units need several GB each.
ARG BAZEL_FLAGS="--jobs=2"

FROM ubuntu:22.04 AS toolchain

# Perform all APT installs in a single layer to reduce image size.
ENV GCC_VERSION=13
ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/Los_Angeles"
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tar \
    wget \
    zip \
    unzip \
    git \
    make \
    rename \
    software-properties-common \
    gnupg \
    build-essential \
    ca-certificates \
    libgnutls30 \
    tzdata \
    language-pack-en \
    default-jre \
    default-jdk \
    protobuf-compiler \
    python3 \
    && add-apt-repository ppa:ubuntu-toolchain-r/test -y \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc-${GCC_VERSION} \
       g++-${GCC_VERSION} \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCC_VERSION} 90 \
       --slave /usr/bin/g++ g++ /usr/bin/g++-${GCC_VERSION} \
    && apt-get install -y --no-install-recommends --only-upgrade libstdc++6

# Create a symlink so 'python' points to 'python3'
RUN ln -s /usr/bin/python3 /usr/bin/python

# Install Bazelisk
ENV USE_BAZEL_VERSION=7.6.1
ARG TARGETARCH
RUN wget -O /usr/local/bin/bazel https://github.com/bazelbuild/bazelisk/releases/download/v1.17.0/bazelisk-linux-${TARGETARCH} \
    && chmod +x /usr/local/bin/bazel

# Build GoogleSQL to cache it for reuse in subsequent Docker builds.
# GoogleSQL can take 3h+ to build, so caching it saves a lot of time.
#
# The compile is a chain of time-boxed segments, each its own stage. A segment
# stops Bazel cleanly when its time is up and the next one carries on from the
# outputs already on disk. CI builds the stages one at a time and keeps each
# one's layers, so a runner that dies part-way loses one segment, not the whole
# compile. The stage after the last segment runs the build to completion, which
# changes nothing when the segments already finished it.
FROM toolchain AS deps-0
WORKDIR /src
COPY build/bazel build/bazel/
COPY MODULE.bazel MODULE.bazel.lock* .bazelversion .bazelrc BUILD.bazel \
    requirements.txt go.mod go.sum ./

FROM deps-0 AS deps-1
ARG DEPS_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${DEPS_TARGETS} ; \
    bazel shutdown ; true

FROM deps-1 AS deps-2
ARG DEPS_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${DEPS_TARGETS} ; \
    bazel shutdown ; true

FROM deps-2 AS deps-3
ARG DEPS_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${DEPS_TARGETS} ; \
    bazel shutdown ; true

FROM deps-3 AS deps-4
ARG DEPS_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${DEPS_TARGETS} ; \
    bazel shutdown ; true

FROM deps-4 AS deps-5
ARG DEPS_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${DEPS_TARGETS} ; \
    bazel shutdown ; true

FROM deps-5 AS deps
ARG DEPS_TARGETS
ARG BAZEL_FLAGS
RUN bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${DEPS_TARGETS}

################################################################################
#                                   BUILD                                      #
################################################################################

# Copy over the emulator code base into the container.
FROM deps AS build-0
COPY . .

# Make enum NodeTag compatible with both C and C++.
RUN find third_party/spanner_pg -name "nodes.h" -exec sed -i 's/enum NodeTag : int/enum NodeTag/g' {} +

# Build the emulator binaries only. Since we are only copying the binaries to
# the release image, we don't need to build the rest of the targets. Segmented
# like the dependencies above.
ENV EXTRA_BAZEL_ARGS="--tool_java_runtime_version=local_jdk"

FROM build-0 AS build-1
ARG BUILD_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${BUILD_TARGETS} ; \
    bazel shutdown ; true

FROM build-1 AS build-2
ARG BUILD_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${BUILD_TARGETS} ; \
    bazel shutdown ; true

FROM build-2 AS build-3
ARG BUILD_TARGETS
ARG SEGMENT_SECONDS
ARG BAZEL_FLAGS
RUN timeout -s INT -k 120 ${SEGMENT_SECONDS} \
      bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${BUILD_TARGETS} ; \
    bazel shutdown ; true

FROM build-3 AS build
ARG BUILD_TARGETS
ARG BAZEL_FLAGS
RUN bazel --host_jvm_args=-Xmx2g build -c opt ${BAZEL_FLAGS} ${BUILD_TARGETS}

# Generate licenses file.
RUN for file in $(find -L bazel-src/external                               \
                       -name "LICENSE" -o -name "COPYING")                   ; \
    do                                                                         \
      echo "----"                                                            ; \
      echo $file                                                             ; \
      echo "----"                                                            ; \
      cat $file                                                              ; \
    done > licenses.txt                                                     && \
    gzip licenses.txt

################################################################################
#                                   RELEASE                                    #
################################################################################

# Now build the release image from the build image.
FROM gcr.io/distroless/cc-debian12

# Copy binaries.
COPY --from=build /src/bazel-bin/binaries/emulator_main .
COPY --from=build /src/bazel-bin/binaries/gateway_main_/gateway_main .

# Copy the libstdc++.so.6 shared library. We use wildcards to execute a conditional
# copy depending on the target architecture.
COPY --from=build /usr/lib/x86_64-linux-gnu*/libstdc++.so.6 /usr/lib/x86_64-linux-gnu
COPY --from=build /usr/lib/aarch64-linux-gnu*/libstdc++.so.6 /usr/lib/aarch64-linux-gnu

# Copy licenses
COPY --from=build /src/licenses.txt.gz .

# Expose the default ports 9010 (gRPC) and 9020 (REST)
EXPOSE 9010 9020

# Run the gateway process, bind to 0.0.0.0 as under MacOS, listening on
# localhost will make the server invisible outside the container.
CMD ["./gateway_main", "--hostname", "0.0.0.0"]
